    <!-- DATAWRAPPER RESPONSIVE EMBED SCRIPT -->
    <script>
        window.addEventListener("message", function(event) {

            if (
                event.origin !== "https://datawrapper.dwcdn.net" ||
                !event.data ||
                !event.data["datawrapper-height"]
            ) {
                return;
            }

            const iframes = document.querySelectorAll(
                'iframe[src*="datawrapper.dwcdn.net"]'
            );

            for (const chartId in event.data["datawrapper-height"]) {

                for (const iframe of iframes) {

                    if (iframe.src.includes("/" + chartId + "/")) {

                        iframe.style.height =
                            event.data["datawrapper-height"][chartId] + "px";

                    }
                }
            }
        });
    </script>

